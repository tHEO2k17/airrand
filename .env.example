# PostgreSQL (used in Phase 1+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/airrand

# API rate limiting (in-memory per process)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READS=120
RATE_LIMIT_MAX_MUTATIONS=30

# Merchant session signing (Phase 6A+)
# Minimum 32 characters (required by API)
AUTH_SESSION_SECRET=change-me-to-a-long-random-session-secret-32-chars
AUTH_SESSION_TTL_MS=604800000

# QR pickup token signing (used in Phase 2+)
# Minimum 32 characters (required by API)
QR_SIGNING_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# App URLs (local development)
MERCHANT_APP_URL=http://localhost:3001

# Merchant Next.js app (browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3003
CUSTOMER_APP_URL=http://localhost:3002

# Customer Next.js app (browser) — also set in apps/customer/.env.local
API_URL=http://localhost:3003
