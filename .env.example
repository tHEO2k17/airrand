# PostgreSQL (used in Phase 1+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/airrand

# Redis (Phase 9A — distributed rate limits; required for worker)
REDIS_URL=redis://localhost:6379

# Background worker (Phase 10A — BullMQ; requires Redis)
WORKER_CONCURRENCY=5

# Audit export object storage (Phase 10E — MinIO locally; S3-compatible in production)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=airrand-exports
# Create bucket on startup when missing (default true except NODE_ENV=production)
STORAGE_AUTO_CREATE_BUCKET=true

# API rate limiting (Redis-backed when REDIS_URL is set; in-memory fallback per process)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READS=120
RATE_LIMIT_MAX_MUTATIONS=30

# Merchant session signing (Phase 6A+)
# Minimum 32 characters (required by API)
AUTH_SESSION_SECRET=change-me-to-a-long-random-session-secret-32-chars
AUTH_SESSION_TTL_MS=604800000

# Merchant login lockout (Redis-backed when REDIS_URL is set; in-memory fallback per process)
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MS=900000
AUTH_LOCKOUT_DURATION_MS=900000

# QR pickup token signing (used in Phase 2+)
# Minimum 32 characters (required by API)
QR_SIGNING_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# CORS — comma-separated browser origins (merchant + customer apps)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Merchant / customer Next.js apps (browser) — also set in apps/*/env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:3003

# Internal merchant onboarding (Phase 11C — pilots only; not public signup)
# Required to call POST /internal/merchants/onboard and the merchant /setup page
INTERNAL_SETUP_SECRET=change-me-to-a-long-random-internal-setup-secret

# Smoke script / tooling (optional)
API_URL=http://localhost:3003
