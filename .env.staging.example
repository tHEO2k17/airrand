# Example staging environment — copy to .env.staging and replace placeholders.
# Do not commit real secrets.

# PostgreSQL (docker-compose service name: postgres)
DATABASE_URL=postgresql://postgres:REPLACE_ME@postgres:5432/airrand

# API secrets (generate random strings ≥ 32 characters)
AUTH_SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS
QR_SIGNING_SECRET=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS

# Session lifetime (ms) — default 7 days
AUTH_SESSION_TTL_MS=604800000

# Rate limiting (in-memory per API process)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_READS=120
RATE_LIMIT_MAX_MUTATIONS=30

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Next.js build-time public API URL (browser → API)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3003

# Smoke script (optional)
API_URL=http://localhost:3003
SMOKE_MERCHANT_EMAIL=owner@demo-cafe.test
SMOKE_MERCHANT_PASSWORD=ChangeMe123!
