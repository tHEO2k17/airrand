{
  "name": "airrand",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @airrand/database db:generate",
    "db:migrate": "pnpm --filter @airrand/database db:migrate",
    "db:seed": "pnpm --filter @airrand/database db:seed",
    "smoke": "bash scripts/smoke-staging.sh"
  },
  "devDependencies": {
    "@airrand/config": "workspace:*",
    "eslint": "^9.28.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
